#include <physical_layouts.dtsi>

/ {
    physical_layout_poc: physical_layout_poc {
        compatible = "zmk,physical-layout";
        display-name = "poc";
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   75       0     0    75>
            , <&key_physical_attrs 100 100  100    0       0   100     0>
            , <&key_physical_attrs 100 100  200(-50)       0   200 (-50)>
            , <&key_physical_attrs 100 100  300    0       0   300     0>
            , <&key_physical_attrs 100 100  400   25       0   400    25>
            , <&key_physical_attrs 100 100  600   25       0   600    25>
            , <&key_physical_attrs 100 100  700    0       0   700     0>
            , <&key_physical_attrs 100 100  800(-50)       0   800 (-50)>
            , <&key_physical_attrs 100 100  900    0       0   900     0>
            , <&key_physical_attrs 100 100 1000   75       0  1000    75>
            , <&key_physical_attrs 100 100    0  175       0     0   175>
            , <&key_physical_attrs 100 100  100  100       0   100   100>
            , <&key_physical_attrs 100 100  200   50       0   200    50>
            , <&key_physical_attrs 100 100  300  100       0   300   100>
            , <&key_physical_attrs 100 100  400  125       0   400   125>
            , <&key_physical_attrs 100 100  600  125       0   600   125>
            , <&key_physical_attrs 100 100  700  100       0   700   100>
            , <&key_physical_attrs 100 100  800   50       0   800    50>
            , <&key_physical_attrs 100 100  900  100       0   900   100>
            , <&key_physical_attrs 100 100 1000  175       0  1000   175>
            , <&key_physical_attrs 100 100  100  200       0   100   200>
            , <&key_physical_attrs 100 100  200  150       0   200   150>
            , <&key_physical_attrs 100 100  300  200       0   300   200>
            , <&key_physical_attrs 100 100  400  225       0   400   225>
            , <&key_physical_attrs 100 100  600  225       0   600   225>
            , <&key_physical_attrs 100 100  700  200       0   700   200>
            , <&key_physical_attrs 100 100  800  150       0   800   150>
            , <&key_physical_attrs 100 100  900  200       0   900   200>
            ;
    };
};
